{
  "name": "manu-control-center",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Constructor portable de sistemas de conocimiento y trabajo con IA.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/afmanu/manu-control-center.git" },
  "engines": { "node": ">=24.14.1 <25" },
  "packageManager": "npm@11.11.0",
  "bin": { "manu-control-center": "dist/cli/main.js" },
  "exports": { ".": "./dist/core/record.js" },
  "types": "dist/core/record.d.ts",
  "files": ["dist/cli", "dist/core", "dist/adapters", "schemas", "examples", "docs", "references"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check:docs": "node scripts/check-docs.mjs",
    "manifest:docs": "node scripts/check-docs.mjs --write",
    "check": "npm run test && npm run check:docs",
    "start": "node dist/cli/main.js",
    "smoke:install": "node scripts/smoke-install.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "ajv": "8.20.0", "ajv-formats": "3.0.1" },
  "devDependencies": { "@types/node": "24.13.3", "typescript": "7.0.2" }
}
