{
  "name": "manu-control-center",
  "version": "0.1.0-dev.11",
  "private": true,
  "description": "Portable builder for AI knowledge and work systems.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afmanu/manu-control-center.git"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "packageManager": "npm@11.11.0",
  "bin": {
    "manu-control-center": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./sqlite": "./dist/adapters/backends/sqlite/store.js",
    "./evals": "./dist/evals/harness.js",
    "./builder": "./dist/builder/index.js",
    "./local": "./dist/adapters/interfaces/local/installation.js",
    "./knowledge": "./dist/adapters/interfaces/local/knowledge.js",
    "./sqlite-knowledge": "./dist/adapters/backends/sqlite/knowledge.js",
    "./review": "./dist/adapters/interfaces/local/review.js",
    "./sqlite-review": "./dist/adapters/backends/sqlite/review.js",
    "./workflows": "./dist/adapters/interfaces/local/workflows.js",
    "./sqlite-workflows": "./dist/adapters/backends/sqlite/workflows.js",
    "./coordinator": "./dist/adapters/interfaces/local/coordinator.js",
    "./sqlite-coordinator": "./dist/adapters/backends/sqlite/coordinator.js",
    "./simulated-mailbox": "./dist/adapters/effects/simulated-mailbox.js",
    "./codex": "./dist/adapters/runtimes/codex.js",
    "./session": "./dist/adapters/interfaces/local/session.js",
    "./sqlite-session": "./dist/adapters/backends/sqlite/session.js",
    "./profile": "./dist/adapters/interfaces/local/profile.js",
    "./documents": "./dist/adapters/backends/documents/store.js"
  },
  "types": "dist/core/index.d.ts",
  "files": [
    "dist/cli",
    "dist/core",
    "dist/adapters",
    "schemas",
    "examples",
    "docs",
    "references",
    "dist/evals",
    "dist/builder",
    ".agents/skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check:docs": "node scripts/check-docs.mjs",
    "manifest:docs": "node scripts/check-docs.mjs --write",
    "check": "npm run test && node scripts/export-schemas.mjs && npm run check:docs",
    "start": "node dist/cli/main.js",
    "smoke:install": "node scripts/smoke-install.mjs",
    "prepack": "npm run build",
    "schemas:write": "npm run build && node scripts/export-schemas.mjs --write",
    "verify:codex": "npm run build && node scripts/verify-codex.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
