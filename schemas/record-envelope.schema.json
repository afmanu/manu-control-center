{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:manu-control-center:record-envelope:0.1.0-draft",
  "title": "RecordEnvelope",
  "description": "Minimal metadata; does not yet validate an entire entity, permission or instance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "instance_id", "revision", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "instance_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "revision": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "updated_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
